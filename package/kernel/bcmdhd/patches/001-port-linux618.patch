--- a/Makefile	2026-10-09 10:14:33.098572260 -0300
+++ b/Makefile	2026-10-09 11:52:08.000000000 -0300
@@ -476,7 +476,10 @@
 #$(warning "BCMDHD_ROOT=$(BCMDHD_ROOT)")
 EXTRA_CFLAGS = $(DHDCFLAGS)
 EXTRA_CFLAGS += -DDHD_COMPILED=\"$(BCMDHD_ROOT)\"
-EXTRA_CFLAGS += -I$(srctree)/$(BCMDHD_ROOT)/include/ -I$(srctree)/$(BCMDHD_ROOT)/
+EXTRA_CFLAGS += -I$(BCMDHD_ROOT)/include/ -I$(BCMDHD_ROOT)/
+EXTRA_CFLAGS += -I/build/openwrt/build_dir/target-aarch64_generic_glibc/linux-rockchip_armv8/mac80211-regular/backports-6.18.39/backport-include/ -I/build/openwrt/build_dir/target-aarch64_generic_glibc/linux-rockchip_armv8/mac80211-regular/backports-6.18.39/backport-include/uapi -I/build/openwrt/build_dir/target-aarch64_generic_glibc/linux-rockchip_armv8/mac80211-regular/backports-6.18.39/include/ -I/build/openwrt/build_dir/target-aarch64_generic_glibc/linux-rockchip_armv8/mac80211-regular/backports-6.18.39/include/uapi
+EXTRA_CFLAGS += -include /build/openwrt/build_dir/target-aarch64_generic_glibc/linux-rockchip_armv8/mac80211-regular/backports-6.18.39/backport-include/backport/backport.h
+EXTRA_CFLAGS += -Wno-error -Wno-missing-prototypes -Wno-empty-body
 ifeq ($(CONFIG_AP6XXX),m)
