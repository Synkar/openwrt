diff -ruN aa/drivers/media/platform/rockchip/rkvenc/vepu2_drv.c bb/drivers/media/platform/rockchip/rkvenc/vepu2_drv.c
--- aa/drivers/media/platform/rockchip/rkvenc/vepu2_drv.c	1969-12-31 21:00:00.000000000 -0300
+++ bb/drivers/media/platform/rockchip/rkvenc/vepu2_drv.c	2026-08-06 20:06:15.493705452 -0300
@@ -0,0 +1,458 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (C) 2023 Rockchip Electronics Co., Ltd.
+ * Copyright (C) 2026 Synkar
+ */
+
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/iommu.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "vepu2_hw.h"
+
+struct rkvenc_hw_info vepu2_hw_info = {
+	.hw = {
+		.reg_num	= VEPU2_REG_NUM,
+		.reg_id		= VEPU2_REG_HW_ID_INDEX,
+		.reg_start	= VEPU2_REG_START_INDEX,
+		.reg_end	= VEPU2_REG_END_INDEX,
+		.reg_en		= VEPU2_REG_ENC_EN_INDEX,
+	},
+	.err_mask	= VEPU2_INT_ERROR_MASK,
+	.vepu_type	= RKVENC_VEPU_2,
+};
+
+static const u16 trans_tbl_default[] = {
+	48, 49, 50, 56, 57, 63, 64, 77, 78, 81
+};
+
+static const u16 trans_tbl_vp8e[] = {
+	27, 44, 45, 48, 49, 50, 56, 57, 63, 64,
+	76, 77, 78, 80, 81, 106, 108,
+};
+
+const struct rkvenc_trans_info vepu2_trans_info[] = {
+	[VEPU2_FMT_RESERVED] = { .count = 0, .table = NULL },
+	[VEPU2_FMT_VP8E]     = { .count = ARRAY_SIZE(trans_tbl_vp8e),
+				 .table = trans_tbl_vp8e },
+	[VEPU2_FMT_JPEGE]    = { .count = ARRAY_SIZE(trans_tbl_default),
+				 .table = trans_tbl_default },
+	[VEPU2_FMT_H264E]    = { .count = ARRAY_SIZE(trans_tbl_default),
+				 .table = trans_tbl_default },
+};
+
+static void vepu2_write_req(struct rkvenc_dev *enc, u32 *reg, u32 s, u32 e,
+			    u32 reg_en)
+{
+	u32 i;
+
+	for (i = s; i < e; i++) {
+		if (i == reg_en)
+			continue;
+		rkvenc_write_relaxed(enc, i * sizeof(u32), reg[i]);
+	}
+}
+
+static void vepu2_read_req(struct rkvenc_dev *enc, u32 *reg, u32 s, u32 e)
+{
+	u32 i;
+
+	for (i = s; i < e; i++)
+		reg[i] = rkvenc_read(enc, i * sizeof(u32));
+}
+
+static int vepu2_check_req(struct mpp_request *req, u32 reg_size,
+			   u32 off_s, u32 off_e)
+{
+	if (req->offset % sizeof(u32) || req->size % sizeof(u32))
+		return -EINVAL;
+	if (req->offset < off_s || req->offset + req->size > off_e)
+		return -EINVAL;
+	if (req->offset + req->size > reg_size)
+		return -EINVAL;
+	return 0;
+}
+
+static int vepu2_extract_task_msg(struct vepu2_task *task,
+				  struct rkvenc_task_msgs *msgs)
+{
+	u32 i;
+	u32 off_s = VEPU2_REG_START_INDEX * sizeof(u32);
+	u32 off_e = (VEPU2_REG_END_INDEX + 1) * sizeof(u32);
+
+	for (i = 0; i < msgs->req_cnt; i++) {
+		struct mpp_request *req = &msgs->reqs[i];
+		int ret;
+
+		if (!req->size)
+			continue;
+
+		switch (req->cmd) {
+		case MPP_CMD_SET_REG_WRITE:
+			ret = vepu2_check_req(req, sizeof(task->reg), off_s, off_e);
+			if (ret)
+				continue;
+			if (copy_from_user((u8 *)task->reg + req->offset,
+					   req->data, req->size))
+				return -EIO;
+			memcpy(&task->w_reqs[task->w_req_cnt++], req,
+			       sizeof(*req));
+			break;
+		case MPP_CMD_SET_REG_READ:
+			ret = vepu2_check_req(req, sizeof(task->reg), off_s, off_e);
+			if (ret)
+				continue;
+			memcpy(&task->r_reqs[task->r_req_cnt++], req,
+			       sizeof(*req));
+			break;
+		case MPP_CMD_SET_REG_ADDR_OFFSET:
+			rkvenc_extract_reg_offset_info(&task->off_inf, req);
+			break;
+		default:
+			break;
+		}
+	}
+	return 0;
+}
+
+static int vepu2_process_reg_fd(struct rkvenc_session *session,
+				struct vepu2_task *task)
+{
+	int fmt = VEPU2_GET_FORMAT(task->reg[VEPU2_REG_ENC_EN_INDEX]);
+	int fd_bs;
+	int ret;
+	u32 j;
+
+	if (session->msg_flags & MPP_FLAGS_REG_NO_OFFSET)
+		fd_bs = task->reg[VEPU2_REG_OUT_INDEX];
+	else
+		fd_bs = task->reg[VEPU2_REG_OUT_INDEX] & 0x3ff;
+
+	ret = rkvenc_translate_reg_address(session, &task->mpp_task, fmt, 0,
+					   task->reg, NULL);
+	if (ret)
+		return ret;
+
+	{
+		const u16 *tbl = session->trans_count ?
+				  session->trans_table :
+				  vepu2_trans_info[fmt].table;
+		u32 cnt = session->trans_count ?
+			  session->trans_count : vepu2_trans_info[fmt].count;
+
+		for (j = 0; j < cnt; j++)
+			task->reg[tbl[j]] +=
+				rkvenc_query_reg_offset_info(&task->off_inf,
+							     tbl[j]);
+	}
+
+	task->bs_buf = rkvenc_dma_find_buffer_fd(session->dma, fd_bs);
+	task->offset_bs = rkvenc_query_reg_offset_info(&task->off_inf,
+						       VEPU2_REG_OUT_INDEX);
+	task->fmt = fmt;
+	return 0;
+}
+
+struct rkvenc_mpp_task *vepu2_alloc_task(struct rkvenc_session *session,
+					 struct rkvenc_task_msgs *msgs)
+{
+	struct vepu2_task *task;
+	struct rkvenc_mpp_task *mpp_task;
+	int ret;
+
+	task = kzalloc(sizeof(*task), GFP_KERNEL);
+	if (!task)
+		return NULL;
+
+	mpp_task = &task->mpp_task;
+	rkvenc_task_init(session, mpp_task);
+	mpp_task->hw_info = &vepu2_hw_info.hw;
+	mpp_task->reg = task->reg;
+
+	ret = vepu2_extract_task_msg(task, msgs);
+	if (ret)
+		goto fail;
+
+	if (!(msgs->flags & MPP_FLAGS_REG_FD_NO_TRANS)) {
+		ret = vepu2_process_reg_fd(session, task);
+		if (ret)
+			goto fail;
+	}
+
+	init_waitqueue_head(&mpp_task->wait);
+	kref_init(&mpp_task->ref);
+	atomic_set(&mpp_task->abort_request, 0);
+	mpp_task->task_index = atomic_inc_return(&session->mpp->task_index);
+	mpp_task->task_id = atomic_inc_return(&session->mpp->queue->task_id);
+	atomic_inc(&session->task_count);
+	atomic_inc(&session->mpp->task_count);
+
+	return mpp_task;
+
+fail:
+	rkvenc_task_finalize(session, mpp_task);
+	kfree(task);
+	return NULL;
+}
+
+int vepu2_hw_run(struct rkvenc_dev *enc, struct rkvenc_mpp_task *mpp_task)
+{
+	struct vepu2_task *task = container_of(mpp_task, struct vepu2_task,
+					       mpp_task);
+	u32 reg_en = VEPU2_REG_ENC_EN_INDEX;
+	u32 i;
+	int ret;
+
+	ret = rkvenc_hw_run_prepare(enc);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < mpp_task->mem_count; i++) {
+		struct rkvenc_mem_region *mr = &mpp_task->mem_regions[i];
+		struct rkvenc_dma_buffer *buf;
+		if (mr->is_dup || !mr->hdl)
+			continue;
+		buf = mr->hdl;
+		rkvenc_dma_buf_sync(buf, 0, buf->size, DMA_TO_DEVICE, false);
+	}
+
+	rkvenc_write_relaxed(enc, VEPU2_REG_CLR_CACHE_BASE, 1);
+
+	rkvenc_write_relaxed(enc, VEPU2_REG_ENC_EN,
+			     task->reg[reg_en] & VEPU2_FORMAT_MASK);
+
+	for (i = 0; i < task->w_req_cnt; i++) {
+		struct mpp_request *req = &task->w_reqs[i];
+		u32 s = req->offset / sizeof(u32);
+		u32 e = s + req->size / sizeof(u32);
+
+		vepu2_write_req(enc, task->reg, s, e, reg_en);
+	}
+
+	rkvenc_hw_run_commit(enc, mpp_task);
+
+	rkvenc_write(enc, VEPU2_REG_ENC_EN, task->reg[reg_en] | VEPU2_ENC_START);
+
+	return 0;
+}
+
+irqreturn_t vepu2_hw_irq(int irq, void *param)
+{
+	struct rkvenc_dev *enc = param;
+	struct rkvenc_mpp_task *mpp_task = enc->cur_task;
+	u32 irq_status;
+
+	irq_status = rkvenc_read(enc, VEPU2_REG_INT);
+	if (!(irq_status & VEPU2_INT_RAW))
+		return IRQ_NONE;
+
+	rkvenc_write(enc, VEPU2_REG_INT, 0);
+
+	if (!mpp_task)
+		return IRQ_NONE;
+
+	if (test_and_set_bit(TASK_STATE_HANDLE, &mpp_task->state)) {
+		dev_err(enc->dev, "task %d already handled\n",
+			mpp_task->task_index);
+		return IRQ_HANDLED;
+	}
+
+	cancel_delayed_work(&mpp_task->timeout_work);
+	set_bit(TASK_STATE_IRQ, &mpp_task->state);
+	enc->irq_status = irq_status;
+	mpp_task->irq_status = irq_status;
+
+	if (VEPU2_INT_ERROR_MASK & irq_status)
+		atomic_inc(&enc->reset_request);
+
+	rkvenc_iommu_dev_deactivate(enc->iommu_info, enc);
+
+	kthread_queue_work(&enc->queue->worker, &enc->work);
+
+	return IRQ_HANDLED;
+}
+
+int vepu2_hw_finish(struct rkvenc_dev *enc, struct rkvenc_mpp_task *mpp_task)
+{
+	struct vepu2_task *task = container_of(mpp_task, struct vepu2_task,
+					       mpp_task);
+	u32 i;
+
+	for (i = 0; i < task->r_req_cnt; i++) {
+		struct mpp_request *req = &task->r_reqs[i];
+		u32 s = req->offset / sizeof(u32);
+		u32 e = s + req->size / sizeof(u32);
+
+		vepu2_read_req(enc, task->reg, s, e);
+	}
+
+	task->reg[VEPU2_REG_INT_INDEX] = mpp_task->irq_status;
+
+	if (task->bs_buf) {
+		u32 size = task->reg[VEPU2_REG_STRM_INDEX] / 8 + task->offset_bs;
+
+		rkvenc_dma_buf_sync(task->bs_buf, 0, size, DMA_FROM_DEVICE, true);
+	}
+	for (i = 0; i < mpp_task->mem_count; i++) {
+		struct rkvenc_mem_region *mr = &mpp_task->mem_regions[i];
+		struct rkvenc_dma_buffer *buf;
+		if (mr->is_dup || !mr->hdl)
+			continue;
+		buf = mr->hdl;
+		rkvenc_dma_buf_sync(buf, 0, buf->size, DMA_BIDIRECTIONAL, true);
+	}
+
+	return 0;
+}
+
+int vepu2_result(struct rkvenc_session *session,
+		 struct rkvenc_mpp_task *mpp_task)
+{
+	struct vepu2_task *task = container_of(mpp_task, struct vepu2_task,
+					       mpp_task);
+	u32 i;
+
+	for (i = 0; i < task->r_req_cnt; i++) {
+		struct mpp_request *req = &task->r_reqs[i];
+
+		if (copy_to_user(req->data, (u8 *)task->reg + req->offset,
+				 req->size))
+			return -EIO;
+	}
+
+	return 0;
+}
+
+void vepu2_free_task(struct rkvenc_mpp_task *mpp_task)
+{
+	struct vepu2_task *task = container_of(mpp_task, struct vepu2_task,
+					       mpp_task);
+
+	kfree(task);
+}
+
+static int vepu2_attach_service(struct rkvenc_dev *enc)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct rkvenc_service *srv;
+	struct rkvenc_taskqueue *queue;
+
+	np = of_parse_phandle(enc->dev->of_node, "rockchip,srv", 0);
+	if (!np || !of_device_is_available(np))
+		return -ENODEV;
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return -ENODEV;
+
+	srv = platform_get_drvdata(pdev);
+	if (!srv)
+		return -EPROBE_DEFER;
+
+	enc->srv = srv;
+
+	queue = srv->task_queues[MPP_DEVICE_VEPU2];
+	if (!queue) {
+		dev_err(enc->dev, "no task queue for VEPU2\n");
+		return -ENODEV;
+	}
+	enc->queue = queue;
+
+	enc->core_id = 0;
+	queue->cores[0] = enc;
+	queue->core_count = 1;
+	queue->core_id_max = 0;
+	set_bit(0, &queue->core_idle);
+
+	kthread_init_work(&enc->work, rkvenc_task_worker_default);
+
+	return 0;
+}
+
+static int vepu2_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rkvenc_dev *enc;
+	struct rkvenc_service *srv;
+	int ret;
+
+	enc = devm_kzalloc(dev, sizeof(*enc), GFP_KERNEL);
+	if (!enc)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, enc);
+
+	ret = rkvenc_hw_probe(enc, pdev);
+	if (ret)
+		return ret;
+
+	enc->hw_info = &vepu2_hw_info;
+	enc->trans_info = vepu2_trans_info;
+
+	enc->alloc_task = vepu2_alloc_task;
+	enc->hw_run = vepu2_hw_run;
+	enc->hw_finish = vepu2_hw_finish;
+	enc->result = vepu2_result;
+	enc->free_task = vepu2_free_task;
+
+	ret = vepu2_attach_service(enc);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to attach service\n");
+		goto err_hw;
+	}
+	srv = enc->srv;
+
+	ret = devm_request_irq(dev, enc->irq, vepu2_hw_irq, IRQF_SHARED,
+			       dev_name(dev), enc);
+	if (ret) {
+		dev_err(dev, "register interrupt failed: %d\n", ret);
+		goto err_hw;
+	}
+
+	srv->sub_devices[MPP_DEVICE_VEPU2] = enc;
+	set_bit(MPP_DEVICE_VEPU2, &srv->hw_support);
+
+	dev_info(dev, "vepu2 probe success (VP8/H.264/JPEG encoder)\n");
+	return 0;
+
+err_hw:
+	rkvenc_hw_remove(enc);
+	return ret;
+}
+
+static void vepu2_remove(struct platform_device *pdev)
+{
+	struct rkvenc_dev *enc = platform_get_drvdata(pdev);
+
+	if (!enc)
+		return;
+	if (enc->srv) {
+		enc->srv->sub_devices[MPP_DEVICE_VEPU2] = NULL;
+		clear_bit(MPP_DEVICE_VEPU2, &enc->srv->hw_support);
+	}
+	rkvenc_hw_remove(enc);
+}
+
+static const struct of_device_id vepu2_dt_match[] = {
+	{ .compatible = "rockchip,rk3588-mpp-vepu2" },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, vepu2_dt_match);
+
+struct platform_driver vepu2_driver = {
+	.probe = vepu2_probe,
+	.remove = vepu2_remove,
+	.driver = {
+		.name = "vepu2-mpp",
+		.of_match_table = vepu2_dt_match,
+	},
+};
diff -ruN aa/drivers/media/platform/rockchip/rkvenc/vepu2_hw.h bb/drivers/media/platform/rockchip/rkvenc/vepu2_hw.h
--- aa/drivers/media/platform/rockchip/rkvenc/vepu2_hw.h	1969-12-31 21:00:00.000000000 -0300
+++ bb/drivers/media/platform/rockchip/rkvenc/vepu2_hw.h	2026-08-06 20:06:15.493705452 -0300
@@ -0,0 +1,72 @@
+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * Copyright (C) 2023 Rockchip Electronics Co., Ltd.
+ * Copyright (C) 2026 Synkar
+ */
+#ifndef __VEPU2_HW_H
+#define __VEPU2_HW_H
+
+#include "rkvenc_hw.h"
+
+#define VEPU2_REG_NUM			184
+#define VEPU2_REG_HW_ID_INDEX		(-1)
+#define VEPU2_REG_START_INDEX		0
+#define VEPU2_REG_END_INDEX		183
+#define VEPU2_REG_OUT_INDEX		(77)
+#define VEPU2_REG_STRM_INDEX		(53)
+
+#define VEPU2_REG_ENC_EN		0x19c
+#define VEPU2_REG_ENC_EN_INDEX		(103)
+#define VEPU2_ENC_START			BIT(0)
+
+#define VEPU2_GET_FORMAT(x)		(((x) >> 4) & 0x3)
+#define VEPU2_FORMAT_MASK		(0x30)
+#define VEPU2_GET_WIDTH(x)		(((x >> 8) & 0x1ff) << 4)
+#define VEPU2_GET_HEIGHT(x)		(((x >> 20) & 0x1ff) << 4)
+
+#define VEPU2_REG_INT			0x1b4
+#define VEPU2_REG_INT_INDEX		(109)
+#define VEPU2_INT_TIMEOUT		BIT(6)
+#define VEPU2_INT_BUF_FULL		BIT(5)
+#define VEPU2_INT_BUS_ERROR		BIT(4)
+#define VEPU2_INT_RAW			BIT(0)
+#define VEPU2_INT_ERROR_MASK		(VEPU2_INT_TIMEOUT | \
+					 VEPU2_INT_BUF_FULL | \
+					 VEPU2_INT_BUS_ERROR)
+
+#define VEPU2_REG_CLR_CACHE_BASE	0xc10
+
+#define VEPU2_FMT_RESERVED		0
+#define VEPU2_FMT_VP8E			1
+#define VEPU2_FMT_JPEGE			2
+#define VEPU2_FMT_H264E			3
+
+extern struct rkvenc_hw_info vepu2_hw_info;
+extern const struct rkvenc_trans_info vepu2_trans_info[];
+
+struct vepu2_task {
+	struct rkvenc_mpp_task mpp_task;
+
+	u32 reg[VEPU2_REG_NUM];
+
+	struct mpp_request w_reqs[MPP_MAX_MSG_NUM];
+	struct mpp_request r_reqs[MPP_MAX_MSG_NUM];
+	u32 w_req_cnt;
+	u32 r_req_cnt;
+
+	struct reg_offset_info off_inf;
+
+	int fmt;
+	struct rkvenc_dma_buffer *bs_buf;
+	u32 offset_bs;
+};
+
+struct rkvenc_mpp_task *vepu2_alloc_task(struct rkvenc_session *session,
+					 struct rkvenc_task_msgs *msgs);
+int vepu2_hw_run(struct rkvenc_dev *enc, struct rkvenc_mpp_task *mpp_task);
+int vepu2_hw_finish(struct rkvenc_dev *enc, struct rkvenc_mpp_task *mpp_task);
+int vepu2_result(struct rkvenc_session *session, struct rkvenc_mpp_task *mpp_task);
+void vepu2_free_task(struct rkvenc_mpp_task *mpp_task);
+irqreturn_t vepu2_hw_irq(int irq, void *param);
+
+#endif /* __VEPU2_HW_H */
