From 9c71b95d9a7743cd432e8b4164c82353c9c628fd Mon Sep 17 00:00:00 2001
From: Lucas Simoes <lucassimoe@gmail.com>
Date: Fri, 30 Oct 2026 23:10:58 -0300
Subject: [PATCH] can: rockchip_canfd: recover from a stuck TX queue

TX completion is driven by the self-received frame (RXSTX). The RK3588
sometimes clears the TX request without ever delivering that frame,
mostly on a bus with frequent transmit errors, and it can also lock up
with a TX request latched in TX_PERIOD and no further interrupts. In
both cases the slot never completes and the TX queue stays stopped until
the interface is taken down.

Implement ndo_tx_timeout and set a 1 s watchdog_timeo. The netdev
watchdog calls it with all TX queues frozen. It takes the bus-off path:
stop the queue and the chip and let the CAN core flush the echo skbs
and restart the controller after restart-ms.
---
 .../net/can/rockchip/rockchip_canfd-core.c    | 25 +++++++++++++++++++
 drivers/net/can/rockchip/rockchip_canfd.h     |  1 +
 2 files changed, 26 insertions(+)

diff --git a/drivers/net/can/rockchip/rockchip_canfd-core.c b/drivers/net/can/rockchip/rockchip_canfd-core.c
index cbfc11c..5d20d95 100644
--- a/drivers/net/can/rockchip/rockchip_canfd-core.c
+++ b/drivers/net/can/rockchip/rockchip_canfd-core.c
@@ -776,10 +776,34 @@ static int rkcanfd_stop(struct net_device *ndev)
 	return 0;
 }
 
+/* The controller sometimes finishes a transmission without the
+ * self-received frame that completes it, and it can lock up with a TX
+ * request latched and no further interrupts. Both leave the TX queue
+ * stopped.
+ * Recover through the bus-off path: the chip is reset and the CAN core
+ * flushes the echo skbs and restarts it after restart-ms.
+ */
+static void rkcanfd_tx_timeout(struct net_device *ndev, unsigned int txqueue)
+{
+	struct rkcanfd_priv *priv = netdev_priv(ndev);
+
+	netdev_warn(ndev,
+		    "TX timeout (tx_head=0x%08x tx_tail=0x%08x state=0x%08x cmd=0x%08x int=0x%08x), restarting\n",
+		    priv->tx_head, priv->tx_tail,
+		    rkcanfd_read(priv, RKCANFD_REG_STATE),
+		    rkcanfd_read(priv, RKCANFD_REG_CMD),
+		    rkcanfd_read(priv, RKCANFD_REG_INT));
+
+	netif_stop_queue(ndev);
+	rkcanfd_chip_stop(priv, CAN_STATE_BUS_OFF);
+	can_bus_off(ndev);
+}
+
 static const struct net_device_ops rkcanfd_netdev_ops = {
 	.ndo_open = rkcanfd_open,
 	.ndo_stop = rkcanfd_stop,
 	.ndo_start_xmit = rkcanfd_start_xmit,
+	.ndo_tx_timeout = rkcanfd_tx_timeout,
 	.ndo_change_mtu = can_change_mtu,
 };
 
@@ -917,6 +941,7 @@ static int rkcanfd_probe(struct platform_device *pdev)
 
 	ndev->netdev_ops = &rkcanfd_netdev_ops;
 	ndev->flags |= IFF_ECHO;
+	ndev->watchdog_timeo = msecs_to_jiffies(RKCANFD_TX_TIMEOUT_MS);
 
 	platform_set_drvdata(pdev, priv);
 	priv->can.clock.freq = clk_get_rate(priv->clks[0].clk);
diff --git a/drivers/net/can/rockchip/rockchip_canfd.h b/drivers/net/can/rockchip/rockchip_canfd.h
index 95bea9b..3b0d806 100644
--- a/drivers/net/can/rockchip/rockchip_canfd.h
+++ b/drivers/net/can/rockchip/rockchip_canfd.h
@@ -293,6 +293,7 @@
 #define RKCANFD_TXFIFO_DEPTH 2
 #define RKCANFD_TX_STOP_THRESHOLD 1
 #define RKCANFD_TX_START_THRESHOLD 1
+#define RKCANFD_TX_TIMEOUT_MS 1000
 
 #define RKCANFD_TIMESTAMP_WORK_MAX_DELAY_SEC 60
 #define RKCANFD_ERRATUM_5_SYSCLOCK_HZ_MIN (300 * MEGA)
-- 
