From e061e93000d43835331f9474e55fd45178eb7caa Mon Sep 17 00:00:00 2001
From: Lucas Simoes <lucassimoe@gmail.com>
Date: Fri, 30 Oct 2026 23:09:28 -0300
Subject: [PATCH] can: rockchip_canfd: don't send a frame without an echo
 skb

TX completion matches each self-received frame (RXSTX) against
echo_skb[tx_tail]. rkcanfd_start_xmit() programs the TX buffer before
installing the echo skb and then advances tx_head and requests the
transmission even when can_put_echo_skb() failed. The slot then stays
pending with echo_skb[] == NULL, can never complete, and once both TX
buffers are in that state the queue is stopped for good while RX keeps
running:

  rockchip_canfd fea50000.can can0: rkcanfd_tx_tail_is_eff:
  echo_skb[0]=NULL tx_head=... tx_tail=...

Install the echo skb first and drop the frame without touching the
hardware if that fails.

---
 drivers/net/can/rockchip/rockchip_canfd-tx.c | 20 ++++++++++++++++----
 1 file changed, 16 insertions(+), 4 deletions(-)

diff --git a/drivers/net/can/rockchip/rockchip_canfd-tx.c b/drivers/net/can/rockchip/rockchip_canfd-tx.c
index 12200dc..afbac42 100644
--- a/drivers/net/can/rockchip/rockchip_canfd-tx.c
+++ b/drivers/net/can/rockchip/rockchip_canfd-tx.c
@@ -117,16 +117,28 @@ netdev_tx_t rkcanfd_start_xmit(struct sk_buff *skb, struct net_device *ndev)
 	tx_head = rkcanfd_get_tx_head(priv);
 	reg_cmd = RKCANFD_REG_CMD_TX_REQ(tx_head);
 
+	/* TX completion matches the self-received frame against
+	 * echo_skb[tx_tail]. A frame sent without an echo skb can never
+	 * complete and stalls the TX queue for good, so install the echo
+	 * skb first and drop the frame if that fails.
+	 */
+	frame_len = can_skb_get_frame_len(skb);
+	err = can_put_echo_skb(skb, ndev, tx_head, frame_len);
+	if (err) {
+		ndev->stats.tx_dropped++;
+		return NETDEV_TX_OK;
+	}
+
+	/* can_put_echo_skb() may have replaced the skb with a clone */
+	cfd = (struct canfd_frame *)priv->can.echo_skb[tx_head]->data;
+
 	rkcanfd_write(priv, RKCANFD_REG_FD_TXFRAMEINFO, reg_frameinfo);
 	rkcanfd_write(priv, RKCANFD_REG_FD_TXID, reg_id);
 	for (i = 0; i < cfd->len; i += 4)
 		rkcanfd_write(priv, RKCANFD_REG_FD_TXDATA0 + i,
 			      *(u32 *)(cfd->data + i));
 
-	frame_len = can_skb_get_frame_len(skb);
-	err = can_put_echo_skb(skb, ndev, tx_head, frame_len);
-	if (!err)
-		netdev_sent_queue(priv->ndev, frame_len);
+	netdev_sent_queue(priv->ndev, frame_len);
 
 	WRITE_ONCE(priv->tx_head, priv->tx_head + 1);
 
-- 
2.43.0

