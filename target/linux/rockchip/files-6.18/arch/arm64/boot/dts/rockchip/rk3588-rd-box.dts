// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2024 Synkar
 *
 * RD-BOX-RK3588 board DTS (mainline bindings).
 *
 * Ported from the vendor SDK DTS (kernel 6.1 fork) to mainline bindings.
 * References: rk3588-rock-5b.dtsi (same rk3588 SoC + rk806 PMIC on spi2),
 *   rp-rk3588-board.dtsi + rd-box-rk3588.dts from the SDK.
 *
 * Vendor -> mainline mapping:
 *   rp_power.led/usb/otg/hub/4g  -> gpio-leds / fixed-regulator / gpio-hog
 *   fan_gpio_control             -> gpio-fan
 *   stm706 (watchdog)            -> linux,wdt-gpio
 *   rp-keys                      -> adc-keys
 *   wireless-wlan/bt (platdata)  -> PCIe enumeration (brcmfmac) / brcm bluetooth
 *
 * TODO phase 4 (hardware validation):
 *   - power/reset GPIO polarities (usb-host, otg, hub, 4g)
 *   - BT bring-up: hci_bcm probe + BCM4362A2.hcd firmware load + HCI up
 *     (binding fixed: compatible brcm,bcm43438-bt + hym8563 lpo clock +
 *      CONFIG_BT_HCIUART_BCM; still needs HW validation)
 *   - real WAN bring-up of synkar-netrole (DHCP uplink + masquerade)
 *   - HDMI audio (hdmi0_sound: deferred probe of asoc-simple-card)
 *
 * Done: CAN0 (rockchip_canfd bind + can0 UP at 500 kbps; see the can0 node).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

#include "rk3588.dtsi"

/ {
	model = "RD-BOX-RK3588";
	compatible = "rd-box,rk3588", "rockchip,rk3588";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	npu_opp_table: opp-table-npu {
		compatible = "operating-points-v2";

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <700000>;
		};
		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <700000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <700000>;
		};
		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <700000>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <700000>;
		};
		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <750000>;
		};
		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <800000>;
		};
		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <850000>;
		};
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* rp_power.led -> gpio4 PA6 (vendor function=3 FLASH/heartbeat) */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_sys>;

		led-sys {
			function = LED_FUNCTION_HEARTBEAT;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	/* fan_gpio_control -> gpio4 PA7, threshold 60C (vendor) */
	gpio_fan: gpio-fan {
		compatible = "gpio-fan";
		gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
		gpio-fan,speed-map = <0 0 3000 1>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_en>;
		#cooling-cells = <2>;
	};

	/* rp-key.dtsi -> adc-keys (saradc channel 1) */
	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-vol-up {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <17000>;
		};

		button-vol-down {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <417000>;
		};

		button-menu {
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <890000>;
		};

		button-back {
			label = "back";
			linux,code = <KEY_BACK>;
			press-threshold-microvolt = <1235000>;
		};
	};

	/* stm706 -> external GPIO watchdog. wdt_gpio = gpio1 PB2 (feed/keepalive).
	 * reset_gpio = gpio1 PB1 is the IC's hardwired reset output (not driven). */
	gpio_watchdog: watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
		hw_algo = "toggle";
		hw_margin_ms = <1500>;
		always-running;
		pinctrl-names = "default";
		pinctrl-0 = <&wdt_feed>;
	};

	/* rp-eth-pcie2gmac: pcie2x1l2 -> NIC Realtek (r8169), power rails */
	pcie20_avdd0v85: regulator-pcie20-avdd0v85 {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd0v85";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		vin-supply = <&vdd_0v85_s0>;
	};

	pcie20_avdd1v8: regulator-pcie20-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd1v8";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&avcc_1v8_s0>;
	};

	/* rp-wifi-bt-pcie-ap6275p: WiFi module vcc3v3, enable gpio0 PB2 */
	vcc3v3_pcie_wifi: regulator-vcc3v3-pcie-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/* rp-pcie2x1l1-m2: M.2 slot vcc3v3, enable gpio4 PA5 (RD_BOX_RK3588) */
	vcc3v3_m2: regulator-vcc3v3-m2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_m2";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&m2_poweren>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/* rp_power: usb-host-power gpio2 PC1 */
	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio2 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&host5v_en>;
		vin-supply = <&vcc5v0_usb>;
	};

	/* rp_power: otg-power gpio1 PA2. always-on: no node consumes VBUS;
	 * without it the regulator stays disabled (dead port). */
	vbus5v0_otg: regulator-vbus5v0-otg {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_otg";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&otg5v_en>;
		vin-supply = <&vcc5v0_usb>;
	};

	/* rp_power: pwr-4g gpio4 PA4 */
	vcc3v3_4g: regulator-vcc3v3-4g {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_4g";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&modem4g_en>;
		startup-delay-us = <10000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/*
	 * CAN0/CAN1: the rk3588 CAN IP matches rk3568v2. The can0/can1 nodes
	 * do NOT exist in mainline rk3588-base.dtsi (only the can0m0/can1m0
	 * pinctrl exists in rk3588-base-pinctrl.dtsi), so the full nodes are
	 * defined here. Driver: rockchip_canfd (CONFIG_CAN_ROCKCHIP_CANFD) ->
	 * compatible "rockchip,rk3568v2-canfd" (mainline has no rk3588
	 * compatible; the vendor used out-of-tree "rockchip,can-2.0" on BSP 6.1).
	 *
	 * interrupts: mainline rk3588 GICv3 is 4-cell (#interrupt-cells = <4>
	 * in rk3588-base.dtsi), inherited from the root. The 4th cell is the
	 * partition/PPI mask (0 for SPI). Do not use the vendor 3-cell GIC
	 * form, or the DT parser fails and platform_get_irq() returns -ENXIO
	 * ("IRQ index 0 not found") — historical CAN0 bring-up bug.
	 *
	 * CAN1 stays DISABLED: can1m0 (gpio3 RK_PB5 = can1_rx_m0) is the SAME
	 * pin as gmac1_txen (eth0 RGMII), required for the primary Ethernet.
	 * The vendor does not enable can1 on this board either. A second CAN
	 * on the hardware would need the can1m1 mux plus a schematic check.
	 */
	can0: can@fea50000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x0 0xfea50000 0x0 0x1000>;
		interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&cru CLK_CAN0>, <&cru PCLK_CAN0>;
		clock-names = "baudclk", "apb_pclk";
		resets = <&cru SRST_CAN0>, <&cru SRST_P_CAN0>;
		reset-names = "can", "can-apb";
		assigned-clocks = <&cru CLK_CAN0>;
		assigned-clock-rates = <300000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&can0m0_pins>;
		status = "okay";
	};

	can1: can@fea60000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x0 0xfea60000 0x0 0x1000>;
		interrupts = <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&cru CLK_CAN1>, <&cru PCLK_CAN1>;
		clock-names = "baudclk", "apb_pclk";
		resets = <&cru SRST_CAN1>, <&cru SRST_P_CAN1>;
		reset-names = "can", "can-apb";
		assigned-clocks = <&cru CLK_CAN1>;
		assigned-clock-rates = <200000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&can1m0_pins>;
		/* can1m0 conflicts with gmac1_txen (gpio3 RK_PB5); see the comment above. */
		status = "disabled";
	};

	/* One 16 MHz crystal per MCP2515. Both nodes use this rate for bit timing. */
	spican_osc: spican_osc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <16000000>;
	};

	/* CAN1_SPI_RESET and CAN2_SPI_RESET are the MCP2515 nRESET pins
	 * (active low): expander IO4/IO5 here, each on its own module.
	 * regulator-fixed asserts its GPIO on enable, so enable = pin high
	 * = reset released requires GPIO_ACTIVE_HIGH + enable-active-high.
	 * With the previous ACTIVE_LOW polarity, enabling vdd drove nRESET
	 * low and held the chip in reset during probe ("didn't enter in
	 * conf mode"). At registration the pin drives low, keeping both
	 * chips in reset until mcp251x probes. startup-delay-us covers
	 * oscillator start after the reset release. */
	spican0_en: regulator-spican0-en {
		compatible = "regulator-fixed";
		regulator-name = "spican0-enable";
		gpio = <&io_expander 4 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
	};

	spican1_en: regulator-spican1-en {
		compatible = "regulator-fixed";
		regulator-name = "spican1-enable";
		gpio = <&io_expander 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
	};

};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l1 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l2 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l3 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

/* Primary Ethernet: gmac1 RGMII (rp-eth-gmac1.dtsi). Timing kept from the vendor
 * (rgmii-rxid, clock input, tx_delay). Reset moved to the phy node (mainline).
 *
 * The eth1_pins group (eth1_refclko_25m, gpio3 PA6) is required: it routes the
 * 25 MHz clock generated by the CRU (REFCLKO25M_ETH1_OUT) to the RTL8211F PHY
 * XTAL pin. Without it the PHY has no clock and does not answer on MDIO,
 * producing "cannot attach to PHY (-ENODEV)". The vendor names this group
 * "eth1_pins". */
&gmac1 {
	phy-mode = "rgmii-rxid";
	clock_in_out = "input";
	tx_delay = <0x44>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus
		     &gmac1_clkinout
		     &eth1_pins>;

	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

&mdio1 {
	/* RTL8211F (vendor: reset gpio3 PB7, 20 ms assert / 100 ms deassert).
	 * The PHY 25 MHz refclk comes from the CRU (REFCLKO25M_ETH1_OUT), routed
	 * to the PHY XTAL pin by eth1_pins/eth1_refclko_25m (gpio3 PA6) on &gmac1.
	 *
	 * compatible "ethernet-phy-id001c.c916" (RTL8211F PHY ID) makes phylib
	 * create the device WITHOUT a premature MDIO read. With the generic
	 * "ethernet-phy-ieee802.3-c22", phylib tries to read the ID BEFORE applying
	 * reset-gpios; the PHY is still in reset, the read fails (-ENODEV), and the
	 * device is never created (reset-gpios stays "UNCLAIMED"). Same pattern as
	 * rk3588-evb1-v10.dts for this RTL8211F. */
	rgmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x1>;
		clocks = <&cru REFCLKO25M_ETH1_OUT>;
		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

/* ===== HDMI0 (display + audio) ============================================
 * Ported from rk3588-evb1-v10.dts (mainline bindings). Differences vs the
 * vendor SDK: the PHY label is &hdptxphy0 (not &hdptxphy_hdmi0) and
 * &route_hdmi0 (vendor-specific) was dropped — mainline describes the pipeline
 * via the OF graph. dw-hdmi-qp takes the PHY by phandle (phys = <&hdptxphy0>)
 * in the base dtsi.
 */
&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&hdmi0 {
	status = "okay";
};

&hdmi0_in {
	hdmi0_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi0>;
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&vp0 {
	vp0_out_hdmi0: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi0_in_vp0>;
	};
};

&hdptxphy0 {
	status = "okay";
};

/* HDMI audio: simple-audio-card (cpu = i2s5_8ch -> codec = hdmi0).
 * The hdmi0_sound node is already wired in rk3588-base.dtsi; only enable it. */
&i2s5_8ch {
	status = "okay";
};

&hdmi0_sound {
	status = "okay";
};

&i2s0_8ch {
	pinctrl-0 = <&i2s0_lrck
		     &i2s0_mclk
		     &i2s0_sclk
		     &i2s0_sdi0
		     &i2s0_sdo0>;
	status = "okay";
};

/* WS2812 on GPIO4_B3 (VCCIO6 3V3), using function I2S1_SDO2_M0 as per the RD-BOX PDF.
 * The default pinctrl for i2s1_8ch also includes PA2, PA5, PA6, PA7, and PB2
 * (PCIe reset, M.2 enable, LED, fan, and NFC RX), but only SDO2 is used here.
 * The stereo pair (data0) is routed to SDO2. Without trcm-sync-tx-only, 
 * starting does not reset the block, so the route remains. The spdif-dit codec
 * is virtual: it just creates the PCM hw:ws2812 for the I2S master. */
&i2s1_8ch {
	/delete-property/ rockchip,trcm-sync-tx-only;
	pinctrl-names = "default";
	pinctrl-0 = <&i2s1m0_sdo2>;
	assigned-clocks = <&cru CLK_I2S1_8CH_TX_SRC>;
	assigned-clock-parents = <&cru PLL_AUPLL>;
	rockchip,i2s-tx-route = <1 2 0 3>;
	status = "okay";
};

/ {
	ws2812_codec: ws2812-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	ws2812-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "ws2812";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,bitclock-master = <&ws2812_cpu>;
		simple-audio-card,frame-master = <&ws2812_cpu>;

		ws2812_cpu: simple-audio-card,cpu {
			sound-dai = <&i2s1_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&ws2812_codec>;
		};
	};
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;
	status = "okay";

	rt5640: audio-codec@1c {
		compatible = "realtek,rt5640";
		reg = <0x1c>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S0_8CH_MCLKOUT>;
		assigned-clock-rates = <12288000>;
		realtek,in1-differential;
		#sound-dai-cells = <0>;
	};
};

/ {
	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";	/* Type A: full-size HDMI */
		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	rt5640-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "RK3588 RD-BOX Headset";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphone Jack";
		simple-audio-card,routing =
			"Mic Jack", "MICBIAS1",
			"IN1P", "Mic Jack",
			"Headphone Jack", "HPOL",
			"Headphone Jack", "HPOR";

		simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&rt5640>;
			system-clock-frequency = <12288000>;
		};
	};
};

/* Combophy for the 3 PCIe slots */
&combphy0_ps {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

&av1d { status = "disabled"; };
&vpu121 { status = "disabled"; };
&vepu2 { status = "okay"; };

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

&rknn_core_0 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_core_1 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_core_2 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_mmu_0 { status = "okay"; };
&rknn_mmu_1 { status = "okay"; };
&rknn_mmu_2 { status = "okay"; };


/* pcie2x1l0: WiFi ap6275p (rp-wifi-bt-pcie-ap6275p)
 * The BCM43752 (AP6275P) needs the 32.768 kHz LPO clock for the firmware to
 * start (without it the ARM is released but the firmware never writes the
 * shared-RAM sentinel -> "FW failed to initialize"). Mainline brcmfmac gets
 * that clock from DT, on the PCI device node, by the name "lpo"
 * (brcmf_of_probe -> devm_clk_get...("lpo")).
 * Same binding as armsom-sige7 (AP6275P + RK3588 + hym8563, working WiFi).
 * Observed BDF: root port 0002:20:00.0 (bus 0x20), wifi 0002:21:00.0 (bus 0x21).
 */
&pcie2x1l0 {
	reset-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie_wifi>;
	status = "okay";

	pcie@0,0 {
		reg = <0x200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		device_type = "pci";
		bus-range = <0x20 0x2f>;

		wifi: wifi@0,0 {
			compatible = "pci14e4,449d";
			reg = <0x210000 0 0 0 0>;
			clocks = <&hym8563>;
			clock-names = "lpo";
		};
	};
};

/* pcie2x1l1: slot M.2 (rp-pcie2x1l1-m2) */
&pcie2x1l1 {
	status = "okay";
};

/* pcie2x1l2: NIC Realtek 2.5G (rp-eth-pcie2gmac) -> driver r8169 */
&pcie2x1l2 {
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;
	status = "okay";

	vdd_cpu_big0_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big0_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: regulator@43 {
		compatible = "rockchip,rk8603", "rockchip,rk8602";
		reg = <0x43>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big1_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;
	status = "okay";

	vdd_npu_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_npu_s0";
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/* i2c3, 400 kHz. Two devices share the bus:
 *   PCA9554 at 0x20 (A2:A0 tied low). INT is GPIO0_D3, open-drain,
 *   level-low. IO0..IO7 are push-pull outputs.
 *   BNO080 in userspace at the secondary address 0x4B. It cannot share
 *   0x20. I2C_IMU_nRESET (IO3) stays free: bno080 drives it, including
 *   holding the part in reset while the node is disabled.
 * CAN1_SPI_RESET and CAN2_SPI_RESET are the active-low RESET# lines of
 * spican0 and spican1.
 * ToF, lidar, IMU-CAN, LED and NFC power are not referenced by a
 * device-tree node, so those lines stay free for userspace. */
&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3m0_xfer>;
	clock-frequency = <400000>;
	status = "okay";

	io_expander: gpio@20 {
		compatible = "nxp,pca9554";
		reg = <0x20>;
		gpio-controller;
		#gpio-cells = <2>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <2>;
		pinctrl-names = "default";
		pinctrl-0 = <&io_exp_int>;
		/* IO4/IO5 belong to spican0/spican1. Every other line is free
		 * for userspace, including I2C_IMU_nRESET. */
		gpio-line-names = "ToF_PWR-On-Off",
				  "LIDAR_PWR-On-Off",
				  "IMU_CAN_PWR-On-Off",
				  "I2C_IMU_nRESET",
				  "CAN1_SPI_RESET",
				  "CAN2_SPI_RESET",
				  "LED_PWR-On-Off",
				  "NFC_PWR-On-Off";
	};
};

/* hym8563 RTC on i2c4 (rd-box-rk3588.dts) */
&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m1_xfer>;
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
	};
};

/* rk806 PMIC on spi2 (same topology as rk3588-rock-5b) */
&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_cs0 &spi2m2_pins>;
	status = "okay";

	pmic@0 {
		compatible = "rockchip,rk806";
		spi-max-frequency = <1000000>;
		reg = <0x0>;

		interrupt-parent = <&gpio0>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>, <&rk806_dvs1_null>,
			    <&rk806_dvs2_null>, <&rk806_dvs3_null>;

		system-power-controller;

		vcc1-supply = <&vcc5v0_sys>;
		vcc2-supply = <&vcc5v0_sys>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc5v0_sys>;
		vcc6-supply = <&vcc5v0_sys>;
		vcc7-supply = <&vcc5v0_sys>;
		vcc8-supply = <&vcc5v0_sys>;
		vcc9-supply = <&vcc5v0_sys>;
		vcc10-supply = <&vcc5v0_sys>;
		vcc11-supply = <&vcc_2v0_pldo_s3>;
		vcc12-supply = <&vcc5v0_sys>;
		vcc13-supply = <&vcc_1v1_nldo_s3>;
		vcc14-supply = <&vcc_1v1_nldo_s3>;
		vcca-supply = <&vcc5v0_sys>;

		gpio-controller;
		#gpio-cells = <2>;

		rk806_dvs1_null: dvs1-null-pins {
			pins = "gpio_pwrctrl1";
			function = "pin_fun0";
		};

		rk806_dvs2_null: dvs2-null-pins {
			pins = "gpio_pwrctrl2";
			function = "pin_fun0";
		};

		rk806_dvs3_null: dvs3-null-pins {
			pins = "gpio_pwrctrl3";
			function = "pin_fun0";
		};

		regulators {
			vdd_gpu_s0: dcdc-reg1 {
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_gpu_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_cpu_lit_s0: dcdc-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_cpu_lit_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_log_s0: dcdc-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <750000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_log_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_vdenc_s0: dcdc-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_vdenc_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_ddr_s0: dcdc-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <900000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vdd2_ddr_s3: dcdc-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vdd2_ddr_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_2v0_pldo_s3: dcdc-reg7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2000000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_2v0_pldo_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <2000000>;
				};
			};

			vcc_3v3_s3: dcdc-reg8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vddq_ddr_s0: dcdc-reg9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vddq_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s3: dcdc-reg10 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avcc_1v8_s0: pldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "avcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s0: pldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avdd_1v2_s0: pldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-name = "avdd_1v2_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3_s0: pldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vcc_3v3_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vccio_sd_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			pldo6_s3: pldo-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "pldo6_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_0v75_s3: nldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_ddr_pll_s0: nldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_ddr_pll_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			avdd_0v75_s0: nldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "avdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v85_s0: nldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_0v85_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v75_s0: nldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&package_thermal {
	polling-delay = <1000>;

	trips {
		package_fan0: package-fan0 {
			temperature = <60000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		map0 {
			trip = <&package_fan0>;
			cooling-device = <&gpio_fan THERMAL_NO_LIMIT 1>;
		};
	};
};

&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

/* uart2 left free for the application (no longer the OS console) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&uart6 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart6m0_xfer>;
	status = "okay";
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart7m1_xfer>;
	status = "okay";
};

&uart8 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart8m0_xfer>;
	status = "okay";
};

/* uart9: BT bus of the ap6275p module (BCM4362A2). Ported from the vendor
 * rp-wifi-bt-pcie-ap6275p.dtsi (bluetooth-platdata) to mainline hci_bcm
 * bindings, following rk3588-armsom-sige7 (same AP6275P + hym8563). GPIOs
 * match the vendor: reset/BT_REG_ON = gpio0 PA0, wake/BT_WAKE = gpio2 PB3,
 * host-wakeup/HOST_WAKE = gpio2 PB0.
 *
 * compatible: mainline hci_bcm has NO of_match entry for the BCM4362A2 —
 * "brcm,bcm4362a2" (used before this change) never probed the driver. Use
 * "brcm,bcm43438-bt", the same approach as armsom-sige7 for the SAME chip:
 * the driver treats every Broadcom UART chip the same way (H4 + set_baud +
 * firmware load) and loads BCM4362A2.hcd via request_firmware.
 *
 * 32.768 kHz LPO clock from the hym8563 RTC: hci_bcm gets it through
 * devm_clk_get_optional(dev, "lpo") (brcm,bluetooth.yaml). Without it the
 * BCM4362A2 firmware does not start (same dependency as brcmfmac on WiFi).
 *
 * host-wakeup: declared as a dedicated interrupt (interrupts +
 * interrupt-names = "host-wakeup"), instead of the deprecated
 * "host-wakeup-gpios" in the binding (brcm,bluetooth.yaml); same pattern as
 * armsom-sige7.
 *
 * RTS/CTS: muxed as the UART function (func 10), NOT as GPIO. Mainline
 * hci_bcm drives flow control through the 8250 MCR
 * (hci_uart_set_flow_control in bcm_suspend/resume_device), instead of the
 * vendor platdata "RTS-gpio switching" (pinctrl toggle between default and
 * rts_gpio). The uart9m0_ctsn/uart9m0_rtsn groups do NOT exist in mainline
 * rk3588-base-pinctrl.dtsi (only the m1/m2 variants), so they are defined in
 * this board's &pinctrl. */
&uart9 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart9m0_xfer &uart9m0_ctsn &uart9m0_rtsn>;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43438-bt";
		clocks = <&hym8563>;
		clock-names = "lpo";
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wakeup";
		shutdown-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_HIGH>;
		max-speed = <1500000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_reset &bt_wake &bt_wake_host_irq>;
		vbat-supply = <&vcc_3v3_s3>;
		vddio-supply = <&vcc_1v8_s3>;
	};
};

/* spi0 M3: two MCP2515 controllers on one bus.
 * CLK GPIO3_D3, MISO GPIO3_D1, MOSI GPIO3_D2 (spi0m3_pins).
 * CS0 GPIO3_D4 and CS1 GPIO3_C7 are both GPIO, active-low.
 *
 * The controller chip select and a GPIO chip select cannot be used
 * together. spi-rockchip sets SER bit 0 on every transfer whose chip
 * select is a GPIO, because the controller only clocks SCLK while an
 * SER bit is set. If that pin stays muxed as the native CS function,
 * the bit selects the native-CS slave at the same time as the GPIO-CS
 * slave and both drive MISO. GPIO3_D4 is muxed as GPIO, so SER bit 0
 * is not wired to a pin.
 *
 * GPIO3_D5 is spi0_cs1_m3 in the SoC pinctrl and is the NFC TX line,
 * so spi0m3_cs1 stays out of pinctrl. Native CS1 is not a substitute.
 * GPIO4_B2 is the NFC RX line. spican0 CS is GPIO3_C7 and spican1 CS is
 * GPIO3_D4; spican0 INT is GPIO3_C4 and spican1 INT is GPIO3_C5. Both
 * INTs stay GPIO, open-drain, active-low, and are not muxed as can2m0
 * or uart5m1. Each module has its own 16 MHz crystal, so spican1 does
 * not depend on spican0 CLKOUT.
 * can-link.sh brings spican1 up at 1 Mbit/s and spican0 at 500 kbit/s. */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m3_pins &spi0_cs_gpios &spican_int_pins>;
	cs-gpios = <&gpio3 RK_PC7 GPIO_ACTIVE_LOW>,
		   <&gpio3 RK_PD4 GPIO_ACTIVE_LOW>;
	num-cs = <2>;
	status = "okay";

	spican0: can@0 {
		compatible = "microchip,mcp2515";
		reg = <0>;
		spi-max-frequency = <10000000>;
		clocks = <&spican_osc>;
		vdd-supply = <&spican0_en>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
	};

	spican1: can@1 {
		compatible = "microchip,mcp2515";
		reg = <1>;
		spi-max-frequency = <10000000>;
		clocks = <&spican_osc>;
		vdd-supply = <&spican1_en>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PC5 IRQ_TYPE_LEVEL_LOW>;
	};
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	no-mmc;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3_s3>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

/* USB (based on rk3588-rock-5b; RD-BOX: 1x OTG type-A + 2x USB2 host + 1x USB3 host) */
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usbdp_phy0 {
	status = "okay";
};

&usbdp_phy1 {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	snps,parkmode-disable-hs-quirk;
	snps,parkmode-disable-ss-quirk;
	status = "okay";
};

&usb_host1_xhci {
	dr_mode = "host";
	snps,parkmode-disable-hs-quirk;
	snps,parkmode-disable-ss-quirk;
	status = "okay";
};

&pinctrl {
	/* The eth1_pins group (eth1_refclko_25m, gpio3 PA6) is already defined by
	 * rk3588-base-pinctrl.dtsi; just reference it from &gmac1 pinctrl-0. */

	/* uart9 RTS/CTS in m0 mode (gpio4 PC4 = RTS, gpio4 PC5 = CTS). These
	 * groups do NOT exist in mainline rk3588-base-pinctrl.dtsi (only m1/m2),
	 * so they are defined here with the vendor pinctrl mapping
	 * (rk3588-vccio3-pinctrl.dtsi). Pinconf is pcfg_pull_none, as in the vendor. */
	uart9 {
		uart9m0_ctsn: uart9m0-ctsn {
			rockchip,pins = <4 RK_PC5 10 &pcfg_pull_none>;
		};

		uart9m0_rtsn: uart9m0-rtsn {
			rockchip,pins = <4 RK_PC4 10 &pcfg_pull_none>;
		};
	};

	/* ap6275p BT GPIOs (pinconf from the vendor rp-wifi-bt-pcie-ap6275p.dtsi,
	 * bt_gpio group). */
	wireless-bluetooth {
		bt_reset: bt-reset {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake: bt-wake {
			rockchip,pins = <2 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		bt_wake_host_irq: bt-wake-host-irq {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	leds {
		led_sys: led-sys {
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	fan {
		fan_en: fan-en {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wdt {
		wdt_feed: wdt-feed {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_poweren: wifi-poweren {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	m2 {
		m2_poweren: m2-poweren {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb-power {
		host5v_en: host5v-en {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		otg5v_en: otg5v-en {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		modem4g_en: modem4g-en {
			rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	/* PCA9554 INT on GPIO0_D3. Open-drain, so the SoC pulls it up. */
	io-expander {
		io_exp_int: io-exp-int {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/* CS pins stay GPIO. Native SPI CS and GPIO CS cannot share this bus. */
	spi0_custom_cs {
		spi0_cs_gpios: spi0-cs-gpios {
			rockchip,pins =
				<3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		spican_int_pins: spican-int-pins {
			rockchip,pins =
				<3 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>,
				<3 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/* NFC on J428. GPIO3_D5 is TX, GPIO4_B2 is RX. Not a UART pair.
	 * Pull-ups hold both idle-high until the nfc task requests them. */
	nfc {
		nfc_pins: nfc-pins {
			rockchip,pins =
				<3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
				<4 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

/* Applies the NFC pinmux only. The nfc task owns both lines. */
/ {
	nfc_pinmux: regulator-nfc-pinmux {
		compatible = "regulator-fixed";
		regulator-name = "nfc-pinmux";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&nfc_pins>;
	};
};

/* rp_power: usb-hub-reset gpio3 PB2 -> deasserted high at boot.
 * GPIO3_D5 (line 29) is the NFC TX line. */
&gpio3 {
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "", "usb-hub-reset", "", "", "", "", "",
			  "", "", "", "", "", "", "", "",
			  "", "", "", "", "", "nfc-tx";

	usb-hub-reset-hog {
		gpio-hog;
		gpios = <RK_PB2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-reset";
	};
};

/* GPIO4_B2 (line 10) is the NFC RX line. */
&gpio4 {
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "", "nfc-rx";
};
