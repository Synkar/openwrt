// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2024 Synkar
 *
 * RD-BOX-RK3588 board DTS (mainline bindings).
 *
 * Portado do DTS do SDK vendor (kernel 6.1 fork) para bindings mainline.
 * Referências: rk3588-rock-5b.dtsi (mesmo SoC rk3588 + PMIC rk806 em spi2),
 *   rp-rk3588-board.dtsi + rd-box-rk3588.dts do SDK.
 *
 * Mapeamento vendor -> mainline:
 *   rp_power.led/usb/otg/hub/4g  -> gpio-leds / fixed-regulator / gpio-hog
 *   fan_gpio_control             -> gpio-fan
 *   stm706 (watchdog)            -> linux,wdt-gpio
 *   rp-keys                      -> adc-keys
 *   wireless-wlan/bt (platdata)  -> PCIe enumeration (brcmfmac) / brcm bluetooth
 *
 * TODO Fase 4 (validação em hardware):
 *   - polaridades dos GPIOs de power/reset (usb-host, otg, hub, 4g)
 *   - bring-up BT: hci_bcm probe + load do FW BCM4362A2.hcd + HCI up
 *     (binding corrigido: compatible brcm,bcm43438-bt + clock lpo do hym8563 +
 *      CONFIG_BT_HCIUART_BCM; falta validar em HW)
 *   - bring-up WAN real do synkar-netrole (uplink DHCP + masquerade)
 *   - audio HDMI (hdmi0_sound: deferred probe do asoc-simple-card)
 *
 * Resolvido: CAN0 (rockchip_canfd bind + can0 UP 500kbps; ver no can0).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>

#include "rk3588.dtsi"

/ {
	model = "RD-BOX-RK3588";
	compatible = "rd-box,rk3588", "rockchip,rk3588";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	npu_opp_table: opp-table-npu {
		compatible = "operating-points-v2";

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <700000>;
		};
		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <700000>;
		};
		opp-500000000 {
			opp-hz = /bits/ 64 <500000000>;
			opp-microvolt = <700000>;
		};
		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <700000>;
		};
		opp-700000000 {
			opp-hz = /bits/ 64 <700000000>;
			opp-microvolt = <700000>;
		};
		opp-800000000 {
			opp-hz = /bits/ 64 <800000000>;
			opp-microvolt = <750000>;
		};
		opp-900000000 {
			opp-hz = /bits/ 64 <900000000>;
			opp-microvolt = <800000>;
		};
		opp-1000000000 {
			opp-hz = /bits/ 64 <1000000000>;
			opp-microvolt = <850000>;
		};
	};

	/* Console: uart2 @ 115200 (baixa para compatibilidade com adaptadores
	 * USB-serial CP2102, que nao suportam 1.5 Mbaud; bate com o debug do
	 * hardware vendor em fiq_debugger serial-id=2 @ 115200). U-Boot rd-box-rk3588
	 * tambem e construido com CONFIG_BAUDRATE=115200 (UBOOT_CUSTOMIZE_CONFIG). */
	chosen {
		stdout-path = "serial2:115200n8";
	};

	vcc12v_dcin: regulator-vcc12v-dcin {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dcin";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc_1v1_nldo_s3: regulator-vcc-1v1-nldo-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v1_nldo_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/* rp_power.led -> gpio4 PA6 (vendor function=3 FLASH/heartbeat) */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_sys>;

		led-sys {
			function = LED_FUNCTION_HEARTBEAT;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	/* fan_gpio_control -> gpio4 PA7, threshold 60C (vendor) */
	gpio_fan: gpio-fan {
		compatible = "gpio-fan";
		gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
		gpio-fan,speed-map = <0 0 3000 1>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_en>;
		#cooling-cells = <2>;
	};

	/* rp-key.dtsi -> adc-keys (saradc channel 1) */
	adc_keys: adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-vol-up {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <17000>;
		};

		button-vol-down {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <417000>;
		};

		button-menu {
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <890000>;
		};

		button-back {
			label = "back";
			linux,code = <KEY_BACK>;
			press-threshold-microvolt = <1235000>;
		};
	};

	/* stm706 -> watchdog externo via GPIO. wdt_gpio=gpio1 PB2 (feed/keepalive),
	 * reset_gpio=gpio1 PB1 eh saida hardwired de reset do IC (nao dirigida). */
	gpio_watchdog: watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
		hw_algo = "toggle";
		hw_margin_ms = <1500>;
		always-running;
		pinctrl-names = "default";
		pinctrl-0 = <&wdt_feed>;
	};

	/* rp-eth-pcie2gmac: pcie2x1l2 -> NIC Realtek (r8169), power rails */
	pcie20_avdd0v85: regulator-pcie20-avdd0v85 {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd0v85";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <850000>;
		vin-supply = <&vdd_0v85_s0>;
	};

	pcie20_avdd1v8: regulator-pcie20-avdd1v8 {
		compatible = "regulator-fixed";
		regulator-name = "pcie20_avdd1v8";
		regulator-boot-on;
		regulator-always-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&avcc_1v8_s0>;
	};

	/* rp-wifi-bt-pcie-ap6275p: vcc3v3 do módulo WiFi, enable gpio0 PB2 */
	vcc3v3_pcie_wifi: regulator-vcc3v3-pcie-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/* rp-pcie2x1l1-m2: vcc3v3 do slot M.2, enable gpio4 PA5 (RD_BOX_RK3588) */
	vcc3v3_m2: regulator-vcc3v3-m2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_m2";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&m2_poweren>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/* rp_power: usb-host-power gpio2 PC1 */
	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio2 RK_PC1 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&host5v_en>;
		vin-supply = <&vcc5v0_usb>;
	};

	/* rp_power: otg-power gpio1 PA2 */
	vbus5v0_otg: regulator-vbus5v0-otg {
		compatible = "regulator-fixed";
		regulator-name = "vbus5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio1 RK_PA2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&otg5v_en>;
		vin-supply = <&vcc5v0_usb>;
	};

	/* rp_power: pwr-4g gpio4 PA4 */
	vcc3v3_4g: regulator-vcc3v3-4g {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_4g";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&modem4g_en>;
		startup-delay-us = <10000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	/*
	 * CAN0/CAN1: o IP CAN do rk3588 equivale ao rk3568v2. Os nos can0/can1
	 * NAO existem no rk3588-base.dtsi mainline (apenas o pinctrl can0m0/can1m0
	 * existe em rk3588-base-pinctrl.dtsi), entao definimos os nos completos
	 * aqui. Driver: rockchip_canfd (CONFIG_CAN_ROCKCHIP_CANFD) -> compatible
	 * "rockchip,rk3568v2-canfd" (o driver mainline nao tem compatible rk3588;
	 * o vendor usava "rockchip,can-2.0" no BSP 6.1 fora-de-arvore).
	 *
	 * interrupts: a GICv3 do rk3588 mainline é 4-cell (#interrupt-cells=<4>
	 * em rk3588-base.dtsi), herdado da raiz. O 4o campo é o partition/PPI-mask
	 * (0 para SPI). NAO usar a forma 3-cell do vendor (GIC 3-cell) senao o
	 * parser de DT falha e platform_get_irq() devolve -ENXIO ("IRQ index 0
	 * not found") — bug historico do bring-up da CAN0.
	 *
	 * CAN1 fica DESABILITADO: can1m0 (gpio3 RK_PB5 = can1_rx_m0) é o MESMO
	 * pino que gmac1_txen (eth0 RGMII), essencial para a ethernet primaria.
	 * O vendor tampouco habilita can1 neste board. Se um 2o CAN existir no
	 * hardware, precisara do mux can1m1 + validacao do esquemático.
	 */
	can0: can@fea50000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x0 0xfea50000 0x0 0x1000>;
		interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&cru CLK_CAN0>, <&cru PCLK_CAN0>;
		clock-names = "baudclk", "apb_pclk";
		resets = <&cru SRST_CAN0>, <&cru SRST_P_CAN0>;
		reset-names = "can", "can-apb";
		assigned-clocks = <&cru CLK_CAN0>;
		assigned-clock-rates = <200000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&can0m0_pins>;
		status = "okay";
	};

	can1: can@fea60000 {
		compatible = "rockchip,rk3568v2-canfd";
		reg = <0x0 0xfea60000 0x0 0x1000>;
		interrupts = <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&cru CLK_CAN1>, <&cru PCLK_CAN1>;
		clock-names = "baudclk", "apb_pclk";
		resets = <&cru SRST_CAN1>, <&cru SRST_P_CAN1>;
		reset-names = "can", "can-apb";
		assigned-clocks = <&cru CLK_CAN1>;
		assigned-clock-rates = <200000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&can1m0_pins>;
		/* can1m0 conflita com gmac1_txen (gpio3 RK_PB5); ver comentario acima. */
		status = "disabled";
	};
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_s0>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_s0>;
};

&cpu_l0 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l1 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l2 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

&cpu_l3 {
	cpu-supply = <&vdd_cpu_lit_s0>;
};

/* Ethernet primario: gmac1 RGMII (rp-eth-gmac1.dtsi). Timing preservado do vendor
 * (rgmii-rxid, clock input, tx_delay). Reset modernizado p/ o no phy (mainline).
 *
 * O grupo eth1_pins (eth1_refclko_25m, gpio3 PA6) é INDISPENSÁVEL: ele roteia o
 * clock de 25MHz gerado pelo CRU (REFCLKO25M_ETH1_OUT) ate o pino XTAL do PHY
 * RTL8211F. Sem ele o PHY fica sem clock e nao responde no MDIO, gerando
 * "cannot attach to PHY (-ENODEV)". O vendor chama esse grupo de "eth1_pins". */
&gmac1 {
	phy-mode = "rgmii-rxid";
	clock_in_out = "input";
	tx_delay = <0x44>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus
		     &gmac1_clkinout
		     &eth1_pins>;

	phy-handle = <&rgmii_phy1>;
	status = "okay";
};

&mdio1 {
	/* RTL8211F (vendor: reset gpio3 PB7, 20ms assert / 100ms deassert).
	 * O refclk 25MHz do PHY vem do CRU (REFCLKO25M_ETH1_OUT) roteado ao pino
	 * XTAL do PHY pelo grupo eth1_pins/eth1_refclko_25m (gpio3 PA6) do &gmac1.
	 *
	 * compatible "ethernet-phy-id001c.c916" (PHY-ID do RTL8211F): faz a phylib
	 * criar o device SEM uma leitura MDIO prematura. Com o generico
	 * "ethernet-phy-ieee802.3-c22" a phylib tenta ler o ID ANTES de aplicar o
	 * reset-gpios; como o PHY esta em reset, a leitura falha (-ENODEV) e o device
	 * nunca é criado (o reset-gpios fica "UNCLAIMED"). Mesmo padrao do
	 * rk3588-evb1-v10.dts para o mesmo PHY RTL8211F. */
	rgmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-id001c.c916";
		reg = <0x1>;
		clocks = <&cru REFCLKO25M_ETH1_OUT>;
		reset-gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <100000>;
	};
};

/* ===== HDMI0 (display + audio) ============================================
 * Portado de rk3588-evb1-v10.dts (bindings mainline). Diferenças vs SDK vendor:
 * o label do PHY é &hdptxphy0 (não &hdptxphy_hdmi0) e o &route_hdmi0
 * (vendor-specific) foi removido — mainline descreve o pipeline via grafo OF.
 * O dw-hdmi-qp pega o PHY por phandle (phys = <&hdptxphy0>) na base dtsi.
 */
&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&hdmi0 {
	status = "okay";
};

&hdmi0_in {
	hdmi0_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi0>;
	};
};

&hdmi0_out {
	hdmi0_out_con: endpoint {
		remote-endpoint = <&hdmi0_con_in>;
	};
};

&vp0 {
	vp0_out_hdmi0: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
		remote-endpoint = <&hdmi0_in_vp0>;
	};
};

&hdptxphy0 {
	status = "okay";
};

/* HDMI audio: simple-audio-card (cpu = i2s5_8ch -> codec = hdmi0).
 * O nó hdmi0_sound já vem pré-wired na rk3588-base.dtsi; basta habilitar. */
&i2s5_8ch {
	status = "okay";
};

&hdmi0_sound {
	status = "okay";
};

&i2s0_8ch {
	pinctrl-0 = <&i2s0_lrck
		     &i2s0_mclk
		     &i2s0_sclk
		     &i2s0_sdi0
		     &i2s0_sdo0>;
	status = "okay";
};

&i2c7 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7m0_xfer>;
	status = "okay";

	rt5640: audio-codec@1c {
		compatible = "realtek,rt5640";
		reg = <0x1c>;
		clocks = <&cru I2S0_8CH_MCLKOUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru I2S0_8CH_MCLKOUT>;
		assigned-clock-rates = <12288000>;
		realtek,in1-differential;
		#sound-dai-cells = <0>;
	};
};

/ {
	hdmi0-con {
		compatible = "hdmi-connector";
		type = "a";	/* Type A: full-size HDMI */
		port {
			hdmi0_con_in: endpoint {
				remote-endpoint = <&hdmi0_out_con>;
			};
		};
	};

	rt5640-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "RK3588 RD-BOX Headset";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphone Jack";
		simple-audio-card,routing =
			"Mic Jack", "MICBIAS1",
			"IN1P", "Mic Jack",
			"Headphone Jack", "HPOL",
			"Headphone Jack", "HPOR";

		simple-audio-card,cpu {
			sound-dai = <&i2s0_8ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&rt5640>;
			system-clock-frequency = <12288000>;
		};
	};
};

/* Combophys para os 3 slots PCIe */
&combphy0_ps {
	status = "okay";
};

&combphy1_ps {
	status = "okay";
};

&combphy2_psu {
	status = "okay";
};

/* Aceleradores de midia: hantro (vpu121 + vepu121_0..3) e rga sao cobertos por
 * drivers mainline (kmod-video-hantro / kmod-video-rga em DEVICE_PACKAGES) e
 * ficam habilitados. Ja o AV1 decoder (av1d, compatible rockchip,rk3588-av1-vpu)
 * NAO tem driver mainline em 6.18 (grep vazio em drivers/**.c; rkvdec so cobre
 * rk3399-vdec) -> desabilitado para nao ficar como consumidor fantasma de
 * power-domain e gerar "sync state() pending due to fdc70000.video-codec". */
&av1d { status = "disabled"; };

&gpu {
	mali-supply = <&vdd_gpu_s0>;
	status = "okay";
};

&rknn_core_0 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_core_1 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_core_2 {
	npu-supply = <&vdd_npu_s0>;
	sram-supply = <&vdd_npu_s0>;
	operating-points-v2 = <&npu_opp_table>;
	status = "okay";
};

&rknn_mmu_0 { status = "okay"; };
&rknn_mmu_1 { status = "okay"; };
&rknn_mmu_2 { status = "okay"; };


/* pcie2x1l0: WiFi ap6275p (rp-wifi-bt-pcie-ap6275p)
 * O BCM43752 (AP6275P) precisa do clock LPO de 32.768kHz para o FW inicializar
 * (sem ele o ARM eh solto mas o FW nunca escreve a sharedram sentinel -> "FW
 * failed to initialize"). Mainline brcmfmac adquire esse clock via DT, no nó do
 * dispositivo PCI, pelo nome "lpo" (brcmf_of_probe -> devm_clk_get...("lpo")).
 * Mesmo binding do armsom-sige7 (AP6275P + RK3588 + hym8563, WiFi funcional).
 * BDF observado: root port 0002:20:00.0 (bus 0x20), wifi 0002:21:00.0 (bus 0x21).
 */
&pcie2x1l0 {
	reset-gpios = <&gpio1 RK_PB4 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie_wifi>;
	status = "okay";

	pcie@0,0 {
		reg = <0x200000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		device_type = "pci";
		bus-range = <0x20 0x2f>;

		wifi: wifi@0,0 {
			compatible = "pci14e4,449d";
			reg = <0x210000 0 0 0 0>;
			clocks = <&hym8563>;
			clock-names = "lpo";
		};
	};
};

/* pcie2x1l1: slot M.2 (rp-pcie2x1l1-m2) */
&pcie2x1l1 {
	status = "okay";
};

/* pcie2x1l2: NIC Realtek 2.5G (rp-eth-pcie2gmac) -> driver r8169 */
&pcie2x1l2 {
	reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0m2_xfer>;
	status = "okay";

	vdd_cpu_big0_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big0_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_s0: regulator@43 {
		compatible = "rockchip,rk8603", "rockchip,rk8602";
		reg = <0x43>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu_big1_s0";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;
	status = "okay";

	vdd_npu_s0: regulator@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_npu_s0";
		regulator-boot-on;
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc5v0_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/* RTC hym8563 no i2c4 (rd-box-rk3588.dts) */
&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m1_xfer>;
	status = "okay";

	hym8563: rtc@51 {
		compatible = "haoyu,hym8563";
		reg = <0x51>;
		#clock-cells = <0>;
		clock-output-names = "hym8563";
	};
};

/* PMIC rk806 em spi2 (mesma topologia do rk3588-rock-5b) */
&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2m2_cs0 &spi2m2_pins>;
	status = "okay";

	pmic@0 {
		compatible = "rockchip,rk806";
		spi-max-frequency = <1000000>;
		reg = <0x0>;

		interrupt-parent = <&gpio0>;
		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;

		pinctrl-names = "default";
		pinctrl-0 = <&pmic_pins>, <&rk806_dvs1_null>,
			    <&rk806_dvs2_null>, <&rk806_dvs3_null>;

		system-power-controller;

		vcc1-supply = <&vcc5v0_sys>;
		vcc2-supply = <&vcc5v0_sys>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc5v0_sys>;
		vcc6-supply = <&vcc5v0_sys>;
		vcc7-supply = <&vcc5v0_sys>;
		vcc8-supply = <&vcc5v0_sys>;
		vcc9-supply = <&vcc5v0_sys>;
		vcc10-supply = <&vcc5v0_sys>;
		vcc11-supply = <&vcc_2v0_pldo_s3>;
		vcc12-supply = <&vcc5v0_sys>;
		vcc13-supply = <&vcc_1v1_nldo_s3>;
		vcc14-supply = <&vcc_1v1_nldo_s3>;
		vcca-supply = <&vcc5v0_sys>;

		gpio-controller;
		#gpio-cells = <2>;

		rk806_dvs1_null: dvs1-null-pins {
			pins = "gpio_pwrctrl1";
			function = "pin_fun0";
		};

		rk806_dvs2_null: dvs2-null-pins {
			pins = "gpio_pwrctrl2";
			function = "pin_fun0";
		};

		rk806_dvs3_null: dvs3-null-pins {
			pins = "gpio_pwrctrl3";
			function = "pin_fun0";
		};

		regulators {
			vdd_gpu_s0: dcdc-reg1 {
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_gpu_s0";
				regulator-enable-ramp-delay = <400>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_cpu_lit_s0: dcdc-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_cpu_lit_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_log_s0: dcdc-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <750000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_log_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_vdenc_s0: dcdc-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <550000>;
				regulator-max-microvolt = <950000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_vdenc_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_ddr_s0: dcdc-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <675000>;
				regulator-max-microvolt = <900000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			vdd2_ddr_s3: dcdc-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vdd2_ddr_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_2v0_pldo_s3: dcdc-reg7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2000000>;
				regulator-max-microvolt = <2000000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vdd_2v0_pldo_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <2000000>;
				};
			};

			vcc_3v3_s3: dcdc-reg8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vddq_ddr_s0: dcdc-reg9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vddq_ddr_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s3: dcdc-reg10 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avcc_1v8_s0: pldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "avcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_1v8_s0: pldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			avdd_1v2_s0: pldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-name = "avdd_1v2_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_3v3_s0: pldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vcc_3v3_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd_s0: pldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-ramp-delay = <12500>;
				regulator-name = "vccio_sd_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			pldo6_s3: pldo-reg6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "pldo6_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_0v75_s3: nldo-reg1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <750000>;
				};
			};

			vdd_ddr_pll_s0: nldo-reg2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_ddr_pll_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <850000>;
				};
			};

			avdd_0v75_s0: nldo-reg3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "avdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v85_s0: nldo-reg4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <850000>;
				regulator-max-microvolt = <850000>;
				regulator-name = "vdd_0v85_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdd_0v75_s0: nldo-reg5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <750000>;
				regulator-max-microvolt = <750000>;
				regulator-name = "vdd_0v75_s0";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};
	};
};

&package_thermal {
	polling-delay = <1000>;

	trips {
		package_fan0: package-fan0 {
			temperature = <60000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		map0 {
			trip = <&package_fan0>;
			cooling-device = <&gpio_fan THERMAL_NO_LIMIT 1>;
		};
	};
};

&saradc {
	vref-supply = <&avcc_1v8_s0>;
	status = "okay";
};

&tsadc {
	status = "okay";
};

/* Console: uart2 @ 115200 (vendor fiq_debugger serial-id=2) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0m0_xfer>;
	status = "okay";
};

&uart6 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart6m0_xfer>;
	status = "okay";
};

&uart7 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart7m1_xfer>;
	status = "okay";
};

&uart8 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart8m0_xfer>;
	status = "okay";
};

/* uart9: barramento BT do modulo ap6275p (chip BCM4362A2). Portado do vendor
 * rp-wifi-bt-pcie-ap6275p.dtsi (bluetooth-platdata) para bindings mainline do
 * hci_bcm, seguindo o rk3588-armsom-sige7 (mesmo AP6275P + hym8563). GPIOs
 * conforme o vendor: reset/BT_REG_ON = gpio0 PA0, wake/BT_WAKE = gpio2 PB3,
 * host-wakeup/HOST_WAKE = gpio2 PB0.
 *
 * compatible: o hci_bcm mainline NAO tem entry para o BCM4362A2 na sua tabela
 * of_match — "brcm,bcm4362a2" (usado antes deste commit) nunca fazia probe do
 * driver. Usamos "brcm,bcm43438-bt", mesma estrategia do armsom-sige7 com o
 * MESMO chip: o driver trata todos os chips Broadcom UART (H4 + set_baud +
 * load FW) da mesma forma e carrega o BCM4362A2.hcd via request_firmware.
 *
 * Clock LPO 32.768kHz do RTC hym8563: o hci_bcm o adquire por
 * devm_clk_get_optional(dev,"lpo") (brcm,bluetooth.yaml). Sem ele o FW do
 * BCM4362A2 nao inicializa (mesma dependencia do brcmfmac no lado WiFi).
 *
 * host-wakeup: declarado como interrupcao dedicada (interrupts +
 * interrupt-names="host-wakeup"), em vez do "host-wakeup-gpios" deprecated no
 * binding (brcm,bluetooth.yaml); mesmo padrao do armsom-sige7.
 *
 * RTS/CTS: muxados como funcao UART (func 10), NAO como GPIO. O mainline
 * hci_bcm controla o flow-control via o MCR do 8250 (hci_uart_set_flow_control
 * em bcm_suspend/resume_device), ao inves do "RTS-gpio switching" do vendor
 * platdata (comutacao de pinctrl entre default e rts_gpio). Os grupos
 * uart9m0_ctsn/uart9m0_rtsn NAO existem no rk3588-base-pinctrl.dtsi mainline
 * (apenas as variantes m1/m2), entao sao definidos no &pinctrl deste board. */
&uart9 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart9m0_xfer &uart9m0_ctsn &uart9m0_rtsn>;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43438-bt";
		clocks = <&hym8563>;
		clock-names = "lpo";
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PB0 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wakeup";
		shutdown-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpio2 RK_PB3 GPIO_ACTIVE_HIGH>;
		max-speed = <1500000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_reset &bt_wake &bt_wake_host_irq>;
		vbat-supply = <&vcc_3v3_s3>;
		vddio-supply = <&vcc_1v8_s3>;
	};
};

/* spi0: spidev (rd-box-rk3588.dts) */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0m3_cs0 &spi0m3_pins>;
	num-cs = <1>;
	status = "okay";

	spidev@0 {
		/* "rohm,dh2228fv" é o id canônico do binding spidev mainline
		 * (o driver recusa "rockchip,spidev" / "spidev" direto). */
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <12000000>;
		spi-lsb-first;
	};
};

&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	no-mmc;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3_s3>;
	vqmmc-supply = <&vccio_sd_s0>;
	status = "okay";
};

/* USB (baseado em rk3588-rock-5b; RD-BOX: 1x OTG type-A + 2x USB2 host + 1x USB3 host) */
&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&usbdp_phy0 {
	status = "okay";
};

&usbdp_phy1 {
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usb_host0_xhci {
	dr_mode = "host";
	status = "okay";
};

&usb_host1_xhci {
	dr_mode = "host";
	status = "okay";
};

&pinctrl {
	/* O grupo eth1_pins (eth1_refclko_25m, gpio3 PA6) já é definido pelo
	 * rk3588-base-pinctrl.dtsi; basta referenciá-lo em &gmac1 pinctrl-0. */

	/* uart9 RTS/CTS em modo m0 (gpio4 PC4=RTS, gpio4 PC5=CTS). Esses grupos
	 * NAO existem no rk3588-base-pinctrl.dtsi mainline (apenas m1/m2), entao
	 * sao definidos aqui com o mesmo mapeamento do pinctrl vendor
	 * (rk3588-vccio3-pinctrl.dtsi). Pinconf pcfg_pull_none, conforme o vendor. */
	uart9 {
		uart9m0_ctsn: uart9m0-ctsn {
			rockchip,pins = <4 RK_PC5 10 &pcfg_pull_none>;
		};

		uart9m0_rtsn: uart9m0-rtsn {
			rockchip,pins = <4 RK_PC4 10 &pcfg_pull_none>;
		};
	};

	/* GPIOs do BT do ap6275p (pinconf conforme o vendor rp-wifi-bt-pcie-
	 * ap6275p.dtsi, grupo bt_gpio). */
	wireless-bluetooth {
		bt_reset: bt-reset {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake: bt-wake {
			rockchip,pins = <2 RK_PB3 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		bt_wake_host_irq: bt-wake-host-irq {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	leds {
		led_sys: led-sys {
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	fan {
		fan_en: fan-en {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wdt {
		wdt_feed: wdt-feed {
			rockchip,pins = <1 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_poweren: wifi-poweren {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	m2 {
		m2_poweren: m2-poweren {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb-power {
		host5v_en: host5v-en {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		otg5v_en: otg5v-en {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		modem4g_en: modem4g-en {
			rockchip,pins = <4 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

/* rp_power: usb-hub-reset gpio3 PB2 -> deassert high no boot */
&gpio3 {
	usb-hub-reset-hog {
		gpio-hog;
		gpios = <RK_PB2 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-reset";
	};
};
